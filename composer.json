{
    "name": "jibaymcs/nuwa",
    "description": "A real CMS plugin for Filament",
    "keywords": [
        "JibayMcs",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "nuwa"
    ],
    "homepage": "https://github.com/jibaymcs/nuwa",
    "support": {
        "issues": "https://github.com/jibaymcs/nuwa/issues",
        "source": "https://github.com/jibaymcs/nuwa"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "JibayMcs",
            "email": "jb@ss2i-digital.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JibayMcs\\Nuwa\\": "src/",
            "JibayMcs\\Nuwa\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JibayMcs\\Nuwa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JibayMcs\\Nuwa\\NuwaServiceProvider"
            ],
            "aliases": {
                "Nuwa": "JibayMcs\\Nuwa\\Facades\\Nuwa"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
